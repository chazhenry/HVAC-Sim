# Copy to deploy/deploy.env (git-ignored) and fill in. Nothing here is a secret
# except the key file DEPLOY_KEY points at, which must stay out of git.

# --- Backend server (any Linux box with nginx, systemd and Python 3.10+) ---
DEPLOY_HOST=
DEPLOY_USER=azureuser
# Path to the SSH private key on THIS machine.
DEPLOY_KEY=../hypercard.ai-homepage/Marconi_ssh_key.pem

# Hostname that serves the API. It needs its own DNS record pointing at
# DEPLOY_HOST; it must not be a name another nginx site already uses.
API_DOMAIN=hvac-api.example.com

# Name of the systemd service. Also used for the system user, /opt and
# /var/lib folders and the nginx site file, so it must be unused on the server.
SERVICE_NAME=hvac-sim

# Local port for the API process. Must be free on the server.
APP_PORT=8031

# Sites allowed to call the API from a browser (comma separated, no trailing slash).
SITE_ORIGINS=https://hypercard.ai,https://www.hypercard.ai

# --- Frontend ---
# Folder the app is served from on the website, with leading and trailing slash.
SITE_PATH=/hvac/
# Checkout of the website repo; the build is copied into its public/ folder.
HOMEPAGE_REPO=../hypercard.ai-homepage
